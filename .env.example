# API and worker: Neon pooled PostgreSQL URL for tenant-scoped application queries.
DATABASE_URL=postgresql://<user>:<password>@<host>/<database>?sslmode=require
# Migration runner only: Neon direct/unpooled PostgreSQL URL for the same branch.
DATABASE_URL_UNPOOLED=postgresql://<user>:<password>@<host>/<database>?sslmode=require
# Worker only: dedicated non-BYPASSRLS bugzero_queue_worker login.
DATABASE_QUEUE_URL=
DATABASE_QUEUE_LOCK_URL=
DATABASE_QUEUE_POOL_MAX=2

# Optional PostgreSQL pool tuning.
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=5000
# Ed25519 JWT keys. Run the API dev-auth:setup script locally to generate a keypair.
# Production must set AUTH_PRIVATE_KEY through a secret manager, never source control.
AUTH_PUBLIC_KEY=
AUTH_PRIVATE_KEY=
AUTH_ISSUER=bugzero-auth
AUTH_AUDIENCE=bugzero-api
AUTH_ACCESS_TOKEN_SECONDS=3600
# Next.js server-side API origin (local API default; Vercel must use the Render API origin).
BUGZERO_API_URL=http://localhost:3001
# Optional server-side AI review. Never expose these as NEXT_PUBLIC_* values.
NVIDIA_API_KEY=
NVIDIA_MODEL=openai/gpt-oss-20b
