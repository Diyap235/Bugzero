DATABASE_URL=postgres://bugzero:bugzero@localhost:5432/bugzero
REDIS_URL=redis://localhost:6379
# Ed25519 JWT keys. Run the API dev-auth:setup script locally to generate a keypair.
# Production must set AUTH_PRIVATE_KEY through a secret manager, never source control.
AUTH_PUBLIC_KEY=
AUTH_PRIVATE_KEY=
AUTH_ISSUER=bugzero-auth
AUTH_AUDIENCE=bugzero-api
AUTH_ACCESS_TOKEN_SECONDS=3600
BUGZERO_API_URL=http://localhost:3001
# Optional server-side AI investigation. Never expose this as a NEXT_PUBLIC_* value.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
